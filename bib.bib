@inproceedings{10.1007/3-540-45337-7_2,
    author = "Boyland, John and Noble, James and Retert, William",
    editor = "Knudsen, J{\o}rgen Lindskov",
    title = "Capabilities for Sharing",
    booktitle = "ECOOP 2001 --- Object-Oriented Programming",
    year = "2001",
    publisher = "Springer Berlin Heidelberg",
    address = "Berlin, Heidelberg",
    pages = "2--27",
    abstract = "Many languages and language extensions include annotations on
                pointer variables suchas ``read-only,'' ``unique,'' and
                ``borrowed''; many more annotations have been proposed but not
                implemented. Unfortunately, all these annotations are described
                individually and formalised independently --- assuming they are
                formalised at all. In this paper, we show how these annotations
                can be subsumed into a general capability system for pointers.
                This system separates mechanism (defining the semantics of
                sharing and exclusion) from policy (defining the invariants that
                are intended to be preserved). The capability system has a
                welldefined semantics which can be used as a reference for the
                correctness of various extended type systems using annotations.
                Furthermore, it supports researchin new less-restrictive type
                systems that permit a wider range of idioms to be statically
                checked.",
    isbn = "978-3-540-45337-6",
}

